rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    match /users/{userId} {
      allow read, write: if true;
    }

    match /pending_users/{userId} {
      allow read, write: if true;
    }

    match /rounds/{roundId} {
      allow read, write: if true;
    }

    match /tournaments/{tournamentId} {
      allow read, write: if true;
    }

    match /player_pins/{playerName} {
      allow read, write: if true;
    }
  }
}

